# النطاق الذي سيستضيف اللعبة (مثال: play.qatra.games)
DOMAIN=play.example.com
# رمز لوحة الإدارة — طويل وعشوائي، لا تشاركه (مثلًا ناتج: openssl rand -hex 24)
ADMIN_TOKEN=change-me-to-a-long-random-secret
PORT=8080
DB_PATH=/data/qatra.db
# تطبيق Android (Capacitor) يتصل من هذا الأصل
CORS_ORIGINS=https://localhost
# Google Play Games (اختياري): عميل OAuth من نوع Web application — انظر docs/WHAT_YOU_NEED.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# التحقق من مشتريات Google Play (اختياري لكن مستحسن): مسار مفتاح حساب الخدمة داخل الحاوية
GOOGLE_SERVICE_ACCOUNT_JSON=
PLAY_PACKAGE=app.qatra.game
